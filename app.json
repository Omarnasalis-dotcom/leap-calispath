{
  "expo": {
    "name": "Leap Arena",
    "slug": "leap-calispath",
    "version": "1.1.5",
    "scheme": "leaparena",
    "orientation": "portrait",
    "icon": "./assets/LEAP.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/LEAP.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leap.calispath",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Leap Arena to save workout completion banners to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Allow Leap Arena to save workout completion banners to your photo library.",
        "NSUserNotificationsUsageDescription": "Leap Arena sends notifications to alert you when your workout timer completes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LEAP.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.leap.calispath",
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "leaparena"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "template": "./web/index.html"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.752787345607-2sjec1b1lt3qjm5qvdgnrddjgeh4muok"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ],
      "expo-router",
      "expo-video",
      "./plugins/withPodfileModularHeaders.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae682d65-32f5-4681-a2b9-0d1b8c98cda2"
      }
    }
  }
}
