EXPO_PUBLIC_GEMINI_KEY=your_gemini_api_key_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sign-In (from Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Sentry (from sentry.io project settings > Client Keys / DSN)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oxxxxx.ingest.sentry.io/xxxxx

# RevenueCat (from app.revenuecat.com > Project settings > Apps > Leap Arena iOS > Public API Key)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
